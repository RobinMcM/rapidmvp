# Domains
APP_DOMAIN=http://localhost:3000
API_DOMAIN=http://localhost:3000
AUTH_API_DOMAIN=http://localhost:3000
AUTH_API_BASE_PATH=/api/auth
NEXT_PUBLIC_APP_DOMAIN=http://localhost:3000
NEXT_PUBLIC_WEBSITE_DOMAIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_API_URL=http://localhost:3000
NEXT_PUBLIC_API_DOMAIN=http://localhost:3000
NEXT_PUBLIC_AUTH_API_BASE_PATH=/api/auth
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Chatbot iframe quick win (optional)
NEXT_PUBLIC_CHATBOT_IFRAME_SRC=http://localhost:3000/chatbot/embed/insolvency?model=openai/gpt-5-pro
NEXT_PUBLIC_CHATBOT_IFRAME_TITLE=Advisory assistant
NEXT_PUBLIC_CHATBOT_IFRAME_WIDTH=380
NEXT_PUBLIC_CHATBOT_IFRAME_HEIGHT=560
NEXT_PUBLIC_CHATBOT_IFRAME_INITIAL_OPEN=false

# Chatbot web-component widget (preferred over iframe when available)
# Optional if EMBED_SRC is set: script URL auto-derives from embed URL origin
# NEXT_PUBLIC_CHATBOT_WIDGET_SRC=http://localhost:3000/chatbot-widget/usageflows-chatbot.js
# Canonical: single URL with all chatbot settings encapsulated
NEXT_PUBLIC_CHATBOT_WIDGET_EMBED_SRC=http://localhost:3000/chatbot/embed?rule=insolvency&model=openai/gpt-5-pro&bg=%23f8fafc
# Legacy split-form options (only used when EMBED_SRC is not set):
# NEXT_PUBLIC_CHATBOT_WIDGET_API_BASE=http://localhost:3000
# NEXT_PUBLIC_CHATBOT_WIDGET_MODE_ID=insolvency
# NEXT_PUBLIC_CHATBOT_WIDGET_MODEL=openai/gpt-5-pro
# NEXT_PUBLIC_CHATBOT_WIDGET_BG_COLOR=#f8fafc
# Optional: contact handoff (cross-origin contact page)
NEXT_PUBLIC_CHATBOT_WIDGET_CONTACT_URL=https://clientsite.com/contact
NEXT_PUBLIC_CHATBOT_WIDGET_CONTACT_TARGET_ORIGIN=https://clientsite.com
NEXT_PUBLIC_CHATBOT_WIDGET_ALLOWED_PARENT_ORIGINS=https://clientsite.com,https://www.clientsite.com

# SuperTokens Core
SUPERTOKENS_CONNECTION_URI=http://localhost:3567
SUPERTOKENS_API_KEY=
SUPERTOKENS_COOKIE_DOMAIN=
