generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SiteRole {
  user
  admin
}

enum AccessStatus {
  active
  suspended
}

model User {
  id                String         @id @default(uuid())
  supertokensUserId String         @unique
  email             String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  siteProfiles      SiteProfile[]
  siteRoles         UserSiteRole[]
  clientProfile     ClientProfile?
}

model Site {
  id            String         @id @default(uuid())
  siteKey       String         @unique
  primaryDomain String         @unique
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  siteProfiles  SiteProfile[]
  siteRoles     UserSiteRole[]
}

model SiteProfile {
  id          String   @id @default(uuid())
  userId      String
  siteId      String
  displayName String
  avatarUrl   String?
  bio         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([userId, siteId])
  @@index([siteId])
}

model UserSiteRole {
  id        String       @id @default(uuid())
  userId    String
  siteId    String
  role      SiteRole     @default(user)
  status    AccessStatus @default(active)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  site      Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([userId, siteId])
  @@index([siteId, role])
}

model Lead {
  id          String   @id @default(uuid())
  name        String
  company     String
  email       String
  projectType String?
  teamSize    String?
  createdAt   DateTime @default(now())
}

// ── Workspace models (migration: add_workspace_models) ──────────────────────

model ClientProfile {
  id         String            @id @default(uuid())
  userId     String            @unique
  company    String?
  role       String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  blueprints ClientBlueprint[]
}

model ClientBlueprint {
  id                   String                @id @default(uuid())
  clientId             String
  slug                 String
  title                String
  status               String                @default("draft")
  summary              String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  client               ClientProfile         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  vision               VisionWorkflow?
  assessments          BuildAssessment[]
  risks                RiskItem[]
  costs                CostEstimate[]
  scripts              BuildScript[]
  documents            DocumentUpload[]
  architectureFindings ArchitectureFinding[]
  acceptanceReport     AcceptanceReport?
  financialAssessment  FinancialAssessment?

  @@index([clientId])
}

model VisionWorkflow {
  id                     String          @id @default(uuid())
  clientBlueprintId      String          @unique
  businessGoal           String?
  targetUsers            String?
  currentPlatform        String?
  expectedGrowth         String?
  integrations           String?
  securityRequirements   String?
  complianceRequirements String?
  preferredCloud         String?
  aiRequirements         String?
  teamCapability         String?
  generatedSummary       String?
  recommendedBlueprint   String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  blueprint              ClientBlueprint @relation(fields: [clientBlueprintId], references: [id], onDelete: Cascade)
}

model BuildAssessment {
  id                String          @id @default(uuid())
  clientBlueprintId String
  layer             String
  status            String          @default("planned")
  description       String?
  tasksJson         String?
  validationJson    String?
  evidenceNotes     String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  blueprint         ClientBlueprint @relation(fields: [clientBlueprintId], references: [id], onDelete: Cascade)
  evidenceItems     EvidenceItem[]

  @@index([clientBlueprintId])
}

model CostEstimate {
  id                String          @id @default(uuid())
  clientBlueprintId String
  category          String
  costLevel         String?
  costDriver        String?
  notes             String?
  optimisation      String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  blueprint         ClientBlueprint @relation(fields: [clientBlueprintId], references: [id], onDelete: Cascade)

  @@index([clientBlueprintId])
}

model RiskItem {
  id                String          @id @default(uuid())
  clientBlueprintId String
  category          String
  severity          String?
  likelihood        String?
  mitigation        String?
  owner             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  blueprint         ClientBlueprint @relation(fields: [clientBlueprintId], references: [id], onDelete: Cascade)

  @@index([clientBlueprintId])
}

model BuildScript {
  id                String          @id @default(uuid())
  clientBlueprintId String
  scriptType        String
  title             String
  content           String
  explanation       String?
  requiredSecrets   String?
  validationSteps   String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  blueprint         ClientBlueprint @relation(fields: [clientBlueprintId], references: [id], onDelete: Cascade)

  @@index([clientBlueprintId])
}

// ── Governance models (migration: add_governance_models) ─────────────────────

model DocumentUpload {
  id                   String               @id @default(uuid())
  clientBlueprintId    String
  fileName             String
  fileType             String
  spacesKey            String
  sizeBytes            Int?
  parseStatus          String               @default("pending")
  parsedAt             DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  blueprint            ClientBlueprint      @relation(fields: [clientBlueprintId], references: [id], onDelete: Cascade)
  findings             DocumentFinding[]
  architectureFindings ArchitectureFinding[]
  evidenceItems        EvidenceItem[]

  @@index([clientBlueprintId])
}

model DocumentFinding {
  id               String         @id @default(uuid())
  documentUploadId String
  findingType      String
  key              String?
  value            String?
  contextJson      String?
  createdAt        DateTime       @default(now())
  document         DocumentUpload @relation(fields: [documentUploadId], references: [id], onDelete: Cascade)

  @@index([documentUploadId])
}

model ArchitectureFinding {
  id                String           @id @default(uuid())
  clientBlueprintId String
  documentUploadId  String?
  category          String
  severity          String
  finding           String
  recommendation    String?
  aiGenerated       Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  blueprint         ClientBlueprint  @relation(fields: [clientBlueprintId], references: [id], onDelete: Cascade)
  document          DocumentUpload?  @relation(fields: [documentUploadId], references: [id], onDelete: SetNull)

  @@index([clientBlueprintId])
}

model AcceptanceReport {
  id                String          @id @default(uuid())
  clientBlueprintId String          @unique
  overallStatus     String
  categoriesJson    String
  aiSummary         String?
  generatedAt       DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  blueprint         ClientBlueprint @relation(fields: [clientBlueprintId], references: [id], onDelete: Cascade)
}

model EvidenceItem {
  id               String          @id @default(uuid())
  assessmentId     String
  evidenceType     String
  title            String
  description      String?
  documentUploadId String?
  url              String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  assessment       BuildAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  document         DocumentUpload? @relation(fields: [documentUploadId], references: [id], onDelete: SetNull)

  @@index([assessmentId])
}

model FinancialAssessment {
  id                String          @id @default(uuid())
  clientBlueprintId String          @unique
  score             Int
  leakageItemsJson  String
  riskDecisionJson  String
  aiSummary         String?
  generatedAt       DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  blueprint         ClientBlueprint @relation(fields: [clientBlueprintId], references: [id], onDelete: Cascade)
}
