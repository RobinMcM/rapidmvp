generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SiteRole {
  user
  admin
}

enum AccessStatus {
  active
  suspended
}

// ── Account / multi-tenant auth ──────────────────────────────────────────────

model User {
  id                String         @id @default(uuid())
  supertokensUserId String         @unique
  email             String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  siteProfiles      SiteProfile[]
  siteRoles         UserSiteRole[]
  accountProfile    AccountProfile?
}

model Site {
  id            String         @id @default(uuid())
  siteKey       String         @unique
  primaryDomain String         @unique
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  siteProfiles  SiteProfile[]
  siteRoles     UserSiteRole[]
}

model SiteProfile {
  id          String   @id @default(uuid())
  userId      String
  siteId      String
  displayName String
  avatarUrl   String?
  bio         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([userId, siteId])
  @@index([siteId])
}

model UserSiteRole {
  id        String       @id @default(uuid())
  userId    String
  siteId    String
  role      SiteRole     @default(user)
  status    AccessStatus @default(active)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  site      Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([userId, siteId])
  @@index([siteId, role])
}

model Lead {
  id          String   @id @default(uuid())
  name        String
  company     String
  email       String
  projectType String?
  teamSize    String?
  createdAt   DateTime @default(now())
}

// ── Account profile (per-user owner of repository packages) ──────────────────

model AccountProfile {
  id                 String              @id @default(uuid())
  userId             String              @unique
  company            String?
  role               String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  repositoryPackages RepositoryPackage[]
}

// ── Repository-to-cloud domain ───────────────────────────────────────────────

// The uploaded repository ZIP plus its cloud-agnostic inspection ("what was
// delivered / what tech it uses"). This is the handover artefact.
model RepositoryPackage {
  id        String @id @default(uuid())
  accountId String
  name      String
  slug      String
  status    String @default("uploaded") // uploaded → inspecting → inspected → failed

  // Inspection results (cloud-agnostic)
  detectedStack  String?
  runtime        String?
  packageManager String?
  buildCommand   String?
  startCommand   String?
  appType        String?
  summary        String?

  detectedServicesJson String? // DB / storage / auth / external services
  envVariablesJson     String? // required secrets/config referenced by the code

  // Repository consistency check (deterministic static analysis)
  consistencyScore         Int?
  consistencyFindingsJson  String?

  // Versioning — re-uploads chain v1 → v2 without a Project layer
  version      Int     @default(1)
  supersedesId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account        AccountProfile      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  supersedes     RepositoryPackage?  @relation("PackageVersion", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy   RepositoryPackage?  @relation("PackageVersion")
  documentUpload DocumentUpload?
  installations  CloudInstallation[]

  @@index([accountId])
}

// A cloud-specific installation plan/execution for a repository package.
// One per (package, provider[, environment]). Azure today; AWS/GCP later.
model CloudInstallation {
  id                  String @id @default(uuid())
  repositoryPackageId String
  provider            String @default("azure") // azure | aws | gcp
  environment         String? // e.g. staging | production
  status              String @default("draft") // draft → configuring → ready → installing → installed → failed
  readinessScore      Int?

  cloudResourcesJson  String?
  secretsMappingJson  String?
  installStepsJson    String?
  risksJson           String?
  recommendationsJson String?

  // Azure Migration Planning (deterministic, rule-based)
  migrationMappingJson      String? // detected → Azure mapping plan (MigrationPlan)
  assumptionsJson           String? // assumptions made while mapping
  clarificationsJson        String? // open questions before a clean cutover
  operationalConfidenceJson String? // 6-category operational readiness snapshot

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  package        RepositoryPackage @relation(fields: [repositoryPackageId], references: [id], onDelete: Cascade)
  handoverReport HandoverReport?

  @@index([repositoryPackageId])
}

// Stakeholder-readable + engineer-readable deployment explanation for an install.
model HandoverReport {
  id                  String   @id @default(uuid())
  cloudInstallationId String   @unique
  audience            String   @default("stakeholder") // stakeholder | engineer
  stakeholderMarkdown String?
  engineerMarkdown    String?
  generatedAt         DateTime @default(now())
  updatedAt           DateTime @updatedAt

  installation CloudInstallation @relation(fields: [cloudInstallationId], references: [id], onDelete: Cascade)
}

// ── Document upload (the ZIP artefact in DO Spaces) ──────────────────────────

model DocumentUpload {
  id                  String    @id @default(uuid())
  repositoryPackageId String?   @unique
  fileName            String
  fileType            String
  spacesKey           String
  sizeBytes           Int?
  parseStatus         String    @default("pending")
  parsedAt            DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  repositoryPackage RepositoryPackage? @relation(fields: [repositoryPackageId], references: [id], onDelete: Cascade)
}
