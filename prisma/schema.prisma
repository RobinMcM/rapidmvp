generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SiteRole {
  user
  admin
}

enum AccessStatus {
  active
  suspended
}

model User {
  id                String         @id @default(uuid())
  supertokensUserId String         @unique
  email             String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  siteProfiles      SiteProfile[]
  siteRoles         UserSiteRole[]
}

model Site {
  id            String         @id @default(uuid())
  siteKey       String         @unique
  primaryDomain String         @unique
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  siteProfiles  SiteProfile[]
  siteRoles     UserSiteRole[]
}

model SiteProfile {
  id          String   @id @default(uuid())
  userId      String
  siteId      String
  displayName String
  avatarUrl   String?
  bio         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([userId, siteId])
  @@index([siteId])
}

model UserSiteRole {
  id        String       @id @default(uuid())
  userId    String
  siteId    String
  role      SiteRole     @default(user)
  status    AccessStatus @default(active)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  site      Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([userId, siteId])
  @@index([siteId, role])
}
